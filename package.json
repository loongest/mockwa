{
	"name": "wasandbox",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Local emulator of the Meta WhatsApp Cloud API",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/loongest/mockwa.git"
	},
	"homepage": "https://github.com/loongest/mockwa#readme",
	"bugs": "https://github.com/loongest/mockwa/issues",
	"license": "MIT",
	"workspaces": [
		"packages/shared",
		"packages/server",
		"packages/web"
	],
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=11.0.0"
	},
	"scripts": {
		"build": "npm run build --workspace @wasandbox/shared && npm run build --workspace @wasandbox/server && npm run build --workspace @wasandbox/web",
		"dev": "concurrently --kill-others-on-fail --names server,web --prefix-colors blue,green \"npm run dev --workspace @wasandbox/server\" \"npm run dev --workspace @wasandbox/web\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"wasandbox": "node --experimental-transform-types --disable-warning=ExperimentalWarning --conditions=development packages/server/src/cli/wasandbox.ts",
		"start": "npm run start --workspace @wasandbox/server",
		"test": "npm run test --workspaces --if-present && npm run test:e2e-targets",
		"test:e2e-targets": "node --test e2e/targets.test.mjs e2e/load-verdict.test.mjs",
		"typecheck": "npm run typecheck --workspaces --if-present"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"concurrently": "^10.0.5",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-unicorn": "^74.0.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0"
	}
}
